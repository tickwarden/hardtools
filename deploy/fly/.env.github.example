# GitHub ile giriş için değerler. Bu dosyayı doldur, izinleri 0600 yap:
#   install -m 600 deploy/fly/.env.github.example deploy/fly/.env.github
# Dosya .gitignore içinde; depoya girmez. deploy.sh bunu okuyup Fly secrets'e yazar.
#
# GitHub → Settings → Developer settings → OAuth Apps → New OAuth App
#   Application name: hardtools-mcp
#   Homepage URL:     https://hardtools-mcp.fly.dev
#   Authorization callback URL: https://hardtools-mcp.fly.dev/oauth/github/callback
#   ✔ Enable Device Flow   (istemci sırrı kullanmayacaksan bunu işaretle)
#
# CLIENT_ID herkese açık bir kimliktir, sır değildir.
HARDTOOLS_OAUTH_GITHUB_CLIENT_ID=
# OPSİYONEL. Boş bırakırsan device flow kullanılır (github.com/login/device'a kod girmek);
# bu durumda sır hiçbir yerde saklanmaz. Doldurursan tarayıcı yönlendirmeli akış kullanılır.
HARDTOOLS_OAUTH_GITHUB_CLIENT_SECRET=
# En az biri dolu olmalı. Virgülle birden fazla yazılabilir.
HARDTOOLS_OAUTH_ALLOWED_LOGINS=
HARDTOOLS_OAUTH_ALLOWED_EMAILS=

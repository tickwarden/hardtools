{
  "profile": "balanced",
  "roots": ["/home/me/projects/my-datapack", "/home/me/projects/my-mod"],
  "fs": {
    "secretScan": "block",
    "denyWrite": [".git", ".git/**", ".claude/**", ".mcp.json", ".husky/**", ".gitmodules", ".github/workflows/**"]
  },
  "shell": {
    "allow": ["git status", "git diff", "git log", "git show", "ls", "pwd", "node --version", "./gradlew build", "./gradlew test"],
    "allowRelativeExecutables": true,
    "timeoutMs": 120000
  },
  "net": {
    "allowDomains": ["docs.papermc.io", "minecraft.wiki", "docs.fabricmc.net", "api.modrinth.com", "github.com", "raw.githubusercontent.com"],
    "loopbackPorts": []
  },
  "audit": { "failClosed": true }
}

{
  "profile": "open",
  "roots": [],
  "fs": {
    "secretScan": "warn",
    "denyWrite": [".git", ".git/**"]
  },
  "shell": {
    "denyCommands": [
      "^(sudo|su|doas|pkexec|chroot)( |$)",
      "^(mkfs(\\.\\w+)?|fdisk|parted|wipefs)( |$)",
      "^(shutdown|reboot|halt|poweroff)( |$)",
      "^(useradd|userdel|usermod|passwd)( |$)",
      "^git( \\S+)* (filter-branch|filter-repo)( |$)",
      "^gh( \\S+)* repo (delete|rename|transfer)( |$)"
    ],
    "denyArgs": [],
    "allowShellSyntax": true,
    "allowRelativeExecutables": true,
    "timeoutMs": 300000
  },
  "net": {
    "allowDomains": [],
    "requireAllowDomains": false
  },
  "audit": { "failClosed": false }
}

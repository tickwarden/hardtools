{
  "name": "hardtools",
  "version": "0.2.0",
  "description": "Hardened MCP tool server: confined fs read/edit/write, code search, argv-only shell, SSRF-safe fetch, tamper-evident audit log.",
  "type": "module",
  "license": "MIT",
  "bin": {
    "hardtools": "dist/index.js"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "npm run build && node --test --test-concurrency=1 \"test/*.test.mjs\"",
    "start": "node dist/index.js",
    "bundle": "npm run build && node build-bundle.mjs",
    "test:bundle": "npm run bundle && HT_ENTRY=bundle/index.js node --test --test-concurrency=1 \"test/integration.test.mjs\""
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "esbuild": "^0.28.2",
    "typescript": "^5.5.0"
  }
}
